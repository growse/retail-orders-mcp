{
  "name": "amazon-orders-mcp",
  "version": "0.1.0",
  "description": "Local MCP server exposing Amazon order history from an Amazon 'Request your data' export",
  "private": true,
  "type": "module",
  "main": "build/index.js",
  "bin": {
    "amazon-orders-mcp": "build/index.js"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node -e \"require('fs').chmodSync('build/index.js', '755')\"",
    "start": "tsx src/index.ts",
    "import": "tsx src/index.ts import",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "type-check": "tsc --noEmit",
    "quality": "npm run format:check && npm run type-check"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "csv-parse": "7.0.3",
    "fflate": "0.8.3",
    "playwright-core": "1.63.0",
    "zod": "4.6.4"
  },
  "devDependencies": {
    "@types/node": "24.13.4",
    "prettier": "3.9.6",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "vitest": "5.0.0"
  }
}
